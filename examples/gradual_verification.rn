// Verification by explicit guard: a predicate is just an `if` whose
// failing branch calls `fail`, so a value outside its range stops the
// program with a message of your choosing. Any predicate works --
// comparisons, `&&`/`||`/`!`, arithmetic -- since it is ordinary code.

let checked = let n: Int = 50 in if n >= 0 && n < 100 then n + 1 else fail("n out of range") in

// The parameter's actual value is unknown until a caller supplies one, so
// the guard runs each time the function is called.
let double_in_range = fun n: Int -> if n >= 0 && n < 100 then n * 2 else fail("n out of range") in

checked + double_in_range(3)
