// Positional product types: a tuple, not a new Value kind -- `(3, 4)` IS
// `Value::List([3, 4])` at runtime (Type::Tuple([Int, Int]) is its static
// type, a fixed-arity/per-position-typed product, see types::Type::Tuple).
//
// renno has no named fields yet (anonymous records are a planned future
// feature) -- so a "Point" here is just a positional (x, y) tuple, read
// back out by destructuring pattern, not `.field` access.
let p: (Int, Int) = (3, 4) in

let sum_of_squares = match p with | (x, y) -> x * x + y * y in

sum_of_squares
