// Records: `{x: 3, y: 4}` -- a fixed-arity, per-position-typed product
// like Tuple, but each position also carries a field NAME, and fields
// are read back by name instead of position. Not a new Value kind
// either -- `{x: 3, y: 4}` desugars to the exact same `Value::List([3,
// 4])` a plain `(3, 4)` tuple would, sorted into canonical (alphabetical)
// field order the moment it's parsed. That's what makes field order not
// matter -- `{y: 4, x: 3}` means the identical thing.
let p = {x: 3, y: 4} in

// No `.field` access -- records are read back by destructuring, the same
// mechanism tuples already use. A bare field name puns to itself:
// `{x, y}` in pattern position means `{x: x, y: y}`.
let sum_of_squares = match p with | {x, y} -> x * x + y * y in

// Type annotations are name-aware, unlike Tuple's own: a `{x: Int}`
// annotation only accepts a value with exactly that field name, not just
// a same-shaped one-field product.
let dx = fun a: {x: Int} -> fun b: {x: Int} ->
  match a with
  | {x: ax} -> match b with
    | {x: bx} -> bx - ax
in

sum_of_squares + dx({x: 1})({x: 5})
