// Tuple types are STRUCTURAL by default: two DIFFERENTLY-named `type`
// aliases for the same shape unify freely -- Meters and Seconds below are
// both just aliases for (Int,), so a plain (Int,) value satisfies either
// annotation with no cast or conversion needed. (types::consistent needs
// no cycle-guard for this: Type::Tuple/Type::Union are always finite
// trees -- an alias name is resolved once, at parse time, to the type
// expression it names, not to a type that can refer back to itself.)
type Meters = (Int,) in
type Seconds = (Int,) in

let identity_meters = fun x: Meters -> x in
let five = identity_meters((5,)) in   // (5,) freely satisfies either alias

// Opt a value OUT of structural matching with `opaque`: a literal,
// singleton per SOURCE POSITION (see types::Type::Token's own doc
// comment) -- two tuples built by calling the SAME function twice carry
// the identical token (`==` compares it like any other value); two
// tuples from DIFFERENTLY-positioned `opaque` expressions never do, even
// with an otherwise-identical shape and identical Int field. In fact
// they're so different that typecheck can already tell their Tuple types
// are never consistent -- comparing them directly is a STATIC type
// error, not a runtime `false` (Type::Token has no surface spelling, so
// there's no way to write that rejection down here as a demo -- try
// deleting the two `dynify` calls below and rerunning to see it fire).
// Erasing both sides to Dyn first defers the comparison to runtime,
// where the real, still-distinct brands settle it instead.
let dynify = fun x: Dyn -> x in
let Meters2 = fun v -> (v, opaque) in
let Seconds2 = fun v -> (v, opaque) in

let same_function_twice_is_equal = Meters2(5) == Meters2(5) in                             // true
let different_functions_are_not_equal = dynify(Meters2(5)) == dynify(Seconds2(5)) in       // false

let n = match five | (v,) -> v in

n + (if same_function_twice_is_equal then 1 else 0) + (if different_functions_are_not_equal then 10 else 0)
// 5 + 1 + 0 = 6
