// Pattern matching: `match e with | pat -> body | ...`, tried top to
// bottom, first match wins. Patterns destructure renno's native shapes:
// literals, tuples (see adts.rn for a hand-rolled tagged-tuple sum type),
// and List's two forms -- `[]`/`[p, ...]` (fixed length) and `h :: t`
// (cons, matches any non-empty list).
//
// `[]` + `h :: t` together are recognized as exhaustive -- try deleting
// either arm below and rerunning; typecheck rejects it before anything
// runs, rather than waiting for a "match failed" panic at some input.
//
// This combines with `let rec` for real list-consuming recursion: `sum`
// below is the pattern-matching equivalent of a `fold`, written by hand.
let rec sum = fun xs ->
  match xs with
  | [] -> 0
  | h :: t -> h + sum(t)
in sum([1, 2, 3, 4, 5])
