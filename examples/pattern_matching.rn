// Pattern matching: `match e with | pat -> body | ...`, tried top to
// bottom, first match wins. No ADTs yet, so patterns destructure only
// renno's native shapes: literals, and List's two forms -- `[]`/`[p, ...]`
// (fixed length) and `h :: t` (cons, matches any non-empty list).
//
// This combines with `let rec` for real list-consuming recursion: `sum`
// below is the pattern-matching equivalent of a `fold`, written by hand.
let rec sum = fun xs ->
  match xs with
  | [] -> 0
  | h :: t -> h + sum(t)
in sum([1, 2, 3, 4, 5])
